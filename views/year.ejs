<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title>Batch of <%= year %> - <%= user.college %></title>
    <link rel="stylesheet" href="/css/style.css">
<link rel="icon" type="image/png" href="/favicon.ico">
    <!-- Chart.js Library for Pie Chart -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .alumni-card { display: flex; flex-direction: column; gap: 1rem; align-items: center; text-align: center; transition: all .2s ease; }
        .alumni-img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid var(--border); }
        .alumni-actions { margin-top: 1rem; display: flex; gap: 0.5rem; }
        .modal { position: fixed; inset: 0; display: none; place-items: center; z-index: 100; padding: 1rem; }
        .modal.open { display: grid; }
        .modal-backdrop { position: absolute; inset: 0; background: rgba(2, 6, 23, 0.6); backdrop-filter: blur(5px); z-index: 1; }
        .modal-panel { position: relative; background: var(--bg); border-radius: var(--radius); padding: 2rem; width: 100%; max-width: 600px; box-shadow: var(--shadow-md); max-height: 90vh; overflow-y: auto; z-index: 2; opacity: 0; transform: translateY(-20px); transition: transform .3s ease, opacity .3s ease; }
        .modal.open .modal-panel { opacity: 1; transform: translateY(0); }
        .modal-close-btn { position: absolute; top: 1rem; right: 1rem; width: 36px; height: 36px; }
        .modal-details { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 1rem; text-align: left; align-items: center; }
        .modal-details strong { color: var(--fg); }
        .modal-details a { color: var(--primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
        .modal-details a:hover { text-decoration: underline; }
        .filter-controls { display: flex; gap: 1rem; padding: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
        .filter-controls input[type="search"], .filter-controls select { flex-grow: 1; min-width: 200px; border: 1px solid var(--border); padding: 0.75rem; border-radius: var(--radius); background-color: var(--bg); color: var(--fg); }
        .stat-card-accent1 { border-top: 4px solid var(--primary); }
        .stat-card-accent2 { border-top: 4px solid var(--accent); }
        .chart-card { border-top: 4px solid #f59e0b; display: grid; place-items: center; padding: 1.5rem; }
        .chart-container { position: relative; height: 150px; width: 150px; }
    </style>
</head>
<body>
    <div class="bg-anim"></div>
    <header class="site-header"><div class="container nav-wrap"><a href="/dashboard" class="brand"><span class="brand-mark">AD</span><span class="brand-text">Admin Panel</span></a></div></header>

    <main class="section container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
            <h1 class="section-title">🎓 Alumni Records: Batch of <%= year %></h1>
            <a href="/dashboard" class="btn btn-outline">← Back to Dashboard</a>
        </div>

        <% if (alumni.length > 0) { %>
            <h2 class="section-title" style="margin-top: 2rem; font-size: 1.2rem;">Batch <%= year %> at a Glance</h2>
            <div class="card-grid" style="margin-top: 1rem; margin-bottom: 3rem;">
                <div class="card stat-card-accent1"><div class="card-icon" style="color: var(--primary);">👥</div><div class="card-title">Total Alumni in Batch</div><p class="card-text" style="font-size: 1.5rem; font-weight: 700; color: var(--fg);"><%= batchStats.totalAlumniInBatch %></p></div>
                <div class="card stat-card-accent2"><div class="card-icon" style="color: var(--accent);">🧑‍🎓</div><div class="card-title">Placed from Campus</div><p class="card-text" style="font-size: 1.5rem; font-weight: 700; color: var(--fg);"><%= batchStats.totalPlacedInBatch %></p></div>
                <div class="card chart-card"><div class="card-title" style="margin-top: 0;">Placement: </div><div class="chart-container"><canvas id="placementPieChart"></canvas></div></div>
            </div>

            <div class="filter-controls card">
                <input type="search" id="nameSearch" placeholder="🔍 Search by name..."><select id="courseFilter"><option value="all">All Courses</option><% const courses = [...new Set(alumni.map(a => a.course))]; %><% courses.sort().forEach(course => { %><option value="<%= course %>"><%= course %></option><% }) %></select>
            </div>

            <div class="card-grid" id="alumniGrid">
                <% alumni.forEach(alumnus => { %>
                    <div class="card alumni-card" data-name="<%= alumnus.fullName.toLowerCase() %>" data-course="<%= alumnus.course %>">
                        <img src="<%= alumnus.image %>" alt="<%= alumnus.fullName %>" class="alumni-img" onerror="this.src='/uploads/images/default-avatar.png'">
                        <div>
                            <div class="card-title"><%= alumnus.fullName %></div>
                            <p class="small muted" style="margin: 0;"><%= alumnus.course %></p>
                            <p class="small" style="margin: 4px 0 0;"> at <strong><%= alumnus.currentCompany %></strong></p>
                        </div>
                        <div class="alumni-actions"><button class="btn btn-primary view-btn" data-details='<%- JSON.stringify(alumnus) %>'>View</button><a href="/alumni/update/<%= alumnus._id %>" class="btn btn-outline">Update</a></div>
                    </div>
                <% }) %>
            </div>
            <div id="noResultsMessage" class="card center" style="display: none; padding: 2rem;"><h2 class="section-title">No Matches Found</h2><p class="muted">Please try adjusting your search criteria.</p></div>
        <% } else { %>
            <div class="card center" style="padding: 2rem;"><h2 class="section-title">No Records Found</h2><p class="muted">There are no alumni records for this batch year yet.</p><a href="/alumni/add" class="btn btn-primary" style="margin-top: 1rem;">Add an Alumnus</a></div>
        <% } %>
    </main>

    <div id="alumniModal" class="modal"><div class="modal-backdrop"></div><div class="modal-panel">
        <button id="modalCloseBtn" class="icon-btn modal-close-btn"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        <div id="modalContent"></div>
    </div></div>

    <!-- --- UPDATED SCRIPT SECTION --- -->
    <script>
        // Best practice: Wrap all your client-side code in a DOMContentLoaded listener
        // Isse yeh ensure hota hai ki pehle poora HTML load ho, fir JavaScript chale.
        document.addEventListener('DOMContentLoaded', () => {

            // --- MODAL LOGIC ---
            const modal = document.getElementById('alumniModal');
            if (modal) {
                const modalContent = document.getElementById('modalContent');
                const modalCloseBtn = document.getElementById('modalCloseBtn');
                const viewBtns = document.querySelectorAll('.view-btn');

                viewBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const details = JSON.parse(btn.dataset.details);
                        const linkedInIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`;
                        modalContent.innerHTML = `<div style="text-align: center; margin-bottom: 1.5rem;"><img src="${details.image}" alt="${details.fullName}" class="alumni-img" style="width: 120px; height: 120px;"><h2 class="section-title" style="margin: 1rem 0 0.25rem;">${details.fullName}</h2>${details.linkedinUrl ? `<a href="${details.linkedinUrl}" target="_blank" class="small muted">${linkedInIcon} View LinkedIn Profile</a>` : ''}</div><div class="modal-details"><strong>Email:</strong> <span>${details.email}</span><strong>Phone:</strong> <span>${details.phone}</span><strong>Roll No:</strong> <span>${details.rollno}</span><strong>Course:</strong> <span>${details.course}</span><strong>Placed from Campus:</strong> <span>${details.placedOnCampus ? 'Yes' : 'No'}</span>${details.placedOnCampus ? `<strong>Initial Company:</strong> <span>${details.initialCompany || 'N/A'}</span><strong>Initial Package:</strong> <span>${details.initialPackage || 'N/A'}</span>` : ''}<strong>Current Company:</strong> <span>${details.currentCompany}</span><strong>Current Package:</strong> <span>${details.currentPackage || 'N/A'}</span></div>`;
                        modal.classList.add('open');
                    });
                });
                
                function closeModal() { modal.classList.remove('open'); }
                modalCloseBtn.addEventListener('click', closeModal);
                modal.querySelector('.modal-backdrop').addEventListener('click', closeModal);
            }

            // --- SEARCH & FILTER LOGIC ---
            const nameSearch = document.getElementById('nameSearch');
            const courseFilter = document.getElementById('courseFilter');
            const alumniGrid = document.getElementById('alumniGrid');
            const alumniCards = alumniGrid ? Array.from(alumniGrid.getElementsByClassName('alumni-card')) : [];
            const noResultsMessage = document.getElementById('noResultsMessage');

            function filterAlumni() {
                const searchTerm = nameSearch.value.toLowerCase();
                const selectedCourse = courseFilter.value;
                let visibleCount = 0;

                alumniCards.forEach(card => {
                    const name = card.dataset.name;
                    const course = card.dataset.course;
                    const nameMatch = name.includes(searchTerm);
                    const courseMatch = (selectedCourse === 'all' || course === selectedCourse);

                    if (nameMatch && courseMatch) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noResultsMessage) {
                    noResultsMessage.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            }
            if (nameSearch) nameSearch.addEventListener('input', filterAlumni);
            if (courseFilter) courseFilter.addEventListener('change', filterAlumni);
            
            // --- PIE CHART LOGIC ---
            const ctx = document.getElementById('placementPieChart');
            if (ctx) {
                // Data EJS se yahan pass ho raha hai
                const totalPlaced = <%= batchStats.totalPlacedInBatch %>;
                const totalAlumni = <%= batchStats.totalAlumniInBatch %>;
                const notPlaced = totalAlumni - totalPlaced;

                new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: ['Placed', 'Not Placed'],
                        datasets: [{
                            label: 'Placement Ratio',
                            data: [totalPlaced, notPlaced],
                            backgroundColor: ['rgba(34, 197, 94, 0.8)', 'rgba(229, 231, 235, 0.8)'],
                            borderColor: ['rgba(34, 197, 94, 1)', 'rgba(209, 213, 219, 1)'],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, padding: 15 }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>

