<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <title>Profile Updated!</title>
<link rel="icon" href="/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .checkmark__circle { 
            stroke-dasharray: 166; 
            stroke-dashoffset: 166; 
            stroke-width: 3; 
            stroke-miterlimit: 10; 
            stroke: var(--accent); 
            fill: none; 
            animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards; 
        }
        .checkmark { 
            width: 80px; 
            height: 80px; 
            border-radius: 50%; 
            display: block; 
            stroke-width: 4; 
            stroke: #fff; 
            stroke-miterlimit: 10; 
            margin: 0 auto; 
            box-shadow: inset 0px 0px 0px var(--accent); 
            animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s both; 
        }
        .checkmark__check { 
            transform-origin: 50% 50%; 
            stroke-dasharray: 48; 
            stroke-dashoffset: 48; 
            animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards; 
        }
        @keyframes stroke { 
            100% { stroke-dashoffset: 0; } 
        }
        @keyframes scale { 
            0%, 100% { transform: none; } 
            50% { transform: scale3d(1.1, 1.1, 1); } 
        }
        @keyframes fill { 
            100% { box-shadow: inset 0px 0px 0px 40px var(--accent); } 
        }
    </style>
</head>
<body>
    <div class="bg-anim"></div>
    <header class="site-header"><div class="container nav-wrap"><a href="#" class="brand"><span class="brand-text">Alumni Network</span></a></div></header>
    <main class="section container">
        <div class="max-600 center card" style="padding: 2.5rem;">
            <div class="checkmark-wrapper">
                <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                    <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
                    <path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
                </svg>
            </div>
            <h1 class="section-title" style="margin-top: 1.5rem;">Profile Updated Successfully!</h1>
            <p class="muted">Thank you for joining your college's alumni network. Your details have been saved, and you can now close this window.</p>
        </div>
    </main>
</body>
</html>

